+def _live_session_active() -> bool:
+    until = get_state(SESSION_LOCK_KEY)
+    if not until:
+        return False
+    try:
+        until_dt = datetime.strptime(until, "%Y-%m-%dT%H:%M:%SZ").replace(
+            tzinfo=timezone.utc
+        )
+    except ValueError:
+        return False
+    return datetime.now(timezone.utc) < until_dt
