# This file is only a FALLBACK, used if a secret isn't found in macOS Keychain
# (e.g. when running on a cloud server that has no Keychain).
# On your Mac, prefer storing secrets in Keychain — see README.md.

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
GROQ_API_KEY=your-groq-api-key

# Optional. Defaults to "base". Set to "tiny" on low-RAM hosts (e.g. Google
# Cloud's free e2-micro, ~1GB RAM) to avoid running out of memory.
WHISPER_MODEL=base
